
// Pour afficher le diagramme --> DBML: Preview
// Les clés primaires sont indiquées par [primary key] et nommées avec le suffixe "_ID".
// Les clés étrangères sont indiquées par [ref: > Table.Colonne] et nommées avec le suffixe "_id".

//  La structure des tables est construite de cette manière :
//    Table nom_table {
//      nom_colonne type_données [paramètres]
//    }

//  [primary key]             // clé primaire
//  [not null]                // valeur obligatoire
//  [null]                    // valeur optionnelle (par défaut)
//  [unique]                  // valeur unique
//  [increment]               // auto-incrémentation
//  [default: valeur]         // valeur par défaut
//  [check: `expression`]     // condition à respecter
//  [note: 'texte']           // note descriptive

//  Types de relations :
//    <: one-to-many 
//    >: many-to-one
//    -: one-to-one 
//    <>: many-to-many

Project Lipids_Database {
  database_type: 'SQLite'
  Note: 'Base de données de lipides bactériens issus de données multi-plateformes de spectrométrie de masse'
}

Table "Organism" {
  Organism_ID integer [primary key, increment]
  Strain text [note: 'Souche bactérienne']
  Genus text  [note: 'Genre bactérien']
  Species text  [note: 'Espèce bactérienne']
  Full_name text [note: 'Nom complet']
}

Table "Experiment" {
  Experiment_ID integer [primary key, increment]
  Organism_id integer [ref: > Organism.Organism_ID]
  treatment text  [note: 'Traitement appliqué']
  culture_mode text  [note: 'Mode de culture']
  DOI text  [note: 'Référence de la publication associée']
}

Table "Method" {
  Method_ID integer [primary key, increment]
  Instrument text [note: 'Nom de l instrument']
  Instrument_type text [note: 'Type d instrument']
  Source text [note: 'Source d ionisation']
  Polarity text [note: 'Polarité d acquisition']
  Fragmentation_mode text [note: 'Mode de fragmentation']
   checks {
    `Polarity = 'positive' OR Polarity = 'negative'` [name: 'chk_polarity']
  }
}

Table "File" {
  File_ID integer [primary key, increment]
  Method_id integer [ref: > Method.Method_ID] // Un fichier mzML est associé à une méthode et une méthode peut être reliée à plusieurs fichiers mzML
  Experiment_id integer [ref: > Experiment.Experiment_ID] // Un fichier mzML est associé à une expérience et une expérience peut être reliée à plusieurs fichiers mzML
  Name_file text [note: 'Nom du fichier mzML']
}

Table "Adduct" {
  Adduct_ID integer [primary key, increment]
  Adduct_name text  [note: 'Notation de l adduct']
  Charge integer  [note: 'Charge de l adduct']

  checks {
  `Charge != 0` [name: 'chk_charge_not_zero']
  }
}

Table "Detection" {
  Detection_ID integer [primary key, increment]
  Adduct_id integer [ref: > Adduct.Adduct_ID] // Une détection est associée à un adduct et un adduct peut être associé à plusieurs détections
  File_id integer [ref: > File.File_ID] // Une détection provient d'un fichier mzML et un fichier mzML peut contenir plusieurs détections        
  Precursor_MZ real [note: 'Rapport masse/charge du précurseur en Da']
  Scan integer  [note: 'Numéro de scan dans le fichier mzML']
  MS_level integer
  Num_Peaks integer [note: 'Nombre de fragments associés au précurseur']
  Energie_collision real [note: 'Énergie de fragmentation, unité dépend du mode de fragmentation']
  Exact_mass real [note: 'Masse exacte monoisotopique en Da']
  Molecular_weight real [note: 'Masse moléculaire moyenne en Da']
  RT real [note: 'Temps de rétention en minutes']
  CCS real

  checks {
    `Precursor_MZ > 0` [name: 'chk_precursor_positive']
    `Exact_mass > 0` [name: 'chk_exact_mass_positive']
    `Molecular_weight > 0` [name: 'chk_molecular_weight_positive']
    `RT >= 0` [name: 'chk_rt_positive']
    `CCS > 0` [name: 'chk_ccs_positive']
  }
}

Table "Fragment" {
  Fragment_ID integer [primary key, increment]
  Detection_id integer [ref: > Detection.Detection_ID] // Un fragment est associé à une détection et une détection peut contenir plusieurs fragments
  MZ real   [note: 'Rapport masse/charge du fragment en Da']
  Intensity real  [note: 'Intensité du signal du fragment']

  checks {
  `MZ > 0` [name: 'chk_fragment_mz_positive']
  `Intensity > 0` [name: 'chk_intensity_positive']
  }
}

Table "Lipid" {
  Lipid_ID integer [primary key, increment]
  Lipid_name text [note: 'Nom du lipide']
  Lipid_class text [note: 'Classe du lipide']
  Lipid_category text [note: 'Catégorie du lipide']
  Formula text [note: 'Formule chimique']
}

Table "Annotation" {
  Annotation_ID integer [primary key, increment]
  Detection_id integer [ref: > Detection.Detection_ID] // Une annotation est associée à une détection et une détection peut avoir plusieurs annotations
  Lipid_id integer [ref: > Lipid.Lipid_ID] // Une annotation est associée à un lipide et un lipide peut être associé à plusieurs annotations
  Confidence_level integer [note: 'Niveau de confiance de l annotation']
  checks {
  `Confidence_level >= 1 AND Confidence_level <= 5` [name: 'chk_confidence_level']
  }
}