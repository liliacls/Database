
// Pour afficher le diagramme --> DBML: Preview
// Les clés primaires sont indiquées par [primary key] et nommées avec le suffixe "_ID" pour une meilleure lisibilité

// La structure des tables est construite de cette manière :
//      Table nom_table {
//        nom_colonne type_données [paramètres]
//      }

//[primary key] ou [pk]     // clé primaire
//[not null]                // valeur obligatoire
//[null]                    // valeur optionnelle (par défaut)
//[unique]                  // valeur unique
//[increment]               // auto-incrémentation
//[default: valeur]         // valeur par défaut
//[check: `expression`]     // condition à respecter
//[note: 'texte']           // note descriptive

// There are 4 types of relationships: one-to-one, one-to-many, many-to-one and many-to-many

//    <: one-to-many 
//    >: many-to-one
//    -: one-to-one : la deuxième colonne est la clé étrangère 
//    <>: many-to-many


Project Lipids_Database {
  database_type: 'SQLite'
  Note: 'Base de données de lipides bactériens issus de données multi-plateformes de spectrométrie de masse'
}

Table "Lipids" {
  Lipids_ID integer [primary key, increment]
  lipid_name text
  lipid_class text
  lipid_category text
  formula text

  note: ''
}

Table "Organism" {
  Organism_ID integer [primary key, increment]
  strain text
  genus text
  species text
  full_name text

  note: ''
}

Table "Condition" {
  Condition_ID integer [primary key, increment]
  Organism_id integer [ref: > Organism.Organism_ID] // Un organisme est associé à plusieurs conditions
  condition_1 text
  condition_2 text

note: ''
}

Table "File" {
  File_ID integer [primary key, increment]
  Method_id integer [ref: > Method.Method_ID] // Un fichier mzML est associé à une méthode
  Organism_id integer [ref: > Organism.Organism_ID] // Un fichier mzML est associé à un organisme
  Condition_id integer [ref: > Condition.Condition_ID] // Un fichier mzML est associé à une condition expérimentale
  date text
  mzML text
  scan integer

  note: ''
}

Table "Fragment" {
  Fragment_ID integer [primary key, increment]
  Detection_id integer [ref: > Detection.Detection_ID] // Un précurseur MZ est associé à plusieurs fragments
  mz real
  intensity real

  checks {
  `mz > 0` [name: 'chk_fragment_mz_positive']
  `intensity > 0` [name: 'chk_intensity_positive']
  }

  note: ''
}

Table "Method" {
  Method_ID integer [primary key, increment]
  Instrument text
  Instrument_type text
  Polarity text

   checks {
    `Polarity = 'positive' OR Polarity = 'negative'` [name: 'chk_polarity']
  }

  note: ''
}

Table "Detection" {
  Detection_ID integer [primary key, increment]
  Collision_id integer [ref: > Collision.Collision_ID] // Une énergie de collision est associée à un précurseur MZ
  Adduct_id integer [ref: > Adducts.Adducts_ID] // Un précurseur MZ est associé à un adduct
  File_id integer [ref: > File.File_ID] // Une détection provient d'un fichier mzML        
  precursor_MZ real
  Exact_mass real
  Molecular_weight real
  mz real
  RT real
  CCS real

  checks {
    `precursor_MZ > 0` [name: 'chk_precursor_positive']
    `Exact_mass > 0` [name: 'chk_exact_mass_positive']
    `Molecular_weight > 0` [name: 'chk_molecular_weight_positive']
    `mz > 0` [name: 'chk_mz_positive']
    `RT >= 0` [name: 'chk_rt_positive']
    `CCS > 0` [name: 'chk_ccs_positive']
  }

  note: ''
}

Table "Collision" {
  Collision_ID integer [primary key, increment]
  energy_collision real

  checks {
    `energy_collision > 0` [name: 'chk_energy_positive']
  }

  note: ''
}

Table "Adducts" {
  Adducts_ID integer [primary key, increment]
  Notation text
  Charge integer

  checks {
  `Charge != 0` [name: 'chk_charge_not_zero']
  }

  note: ''
}

Table "Annotation" {
  Annotation_ID integer [primary key, increment]
  Detection_id integer [ref: > Detection.Detection_ID] // Une annotation relie une détection à un lipide
  Lipid_id integer [ref: > Lipids.Lipids_ID] // Une annotation est associée à un lipide identifié
  confidence_level text

  checks {
  `confidence_level >= 1 AND confidence_level <= 5` [name: 'chk_confidence_level']
  }

  note: ''
}